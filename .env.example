# Use the exact public HTTPS origin in production, with no trailing path.
SITE_URL=http://localhost:3000

# Public Supabase browser configuration. Never place the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Customer-facing GCash instructions. The name and number must match the
# account in the QR code. The QR defaults to public/gcash-qr.jpg; set
# GCASH_QR_IMAGE_PATH only to use a different file in public/.
GCASH_ACCOUNT_NAME=
GCASH_MOBILE_NUMBER=
GCASH_QR_IMAGE_PATH=

# Server-only Resend credentials used for operational customer emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Tiffany's Pickleball Court
